      "status": "artifact_captured",
      "duration_seconds": 70.032
    },
    {
      "take": "02",
      "first": "The building wrapped around a narrow courtyard with a pump in the middle and laundry lines overhead.",
      "last": "The fire was inside the wall.",
      "provider_context_id": "116dbcdc969748c39b4e98afc6deee4b",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=116dbcdc969748c39b4e98afc6deee4b",
