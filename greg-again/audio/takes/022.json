      "status": "artifact_captured",
      "duration_seconds": 76.584
    },
    {
      "take": "03",
      "first": "I set the buckets down.",
      "last": "The plaster broke against his shoulder instead of his temple and exploded across the floor.",
      "provider_context_id": "b3bced509f904256bd6d49f12acedc77",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=b3bced509f904256bd6d49f12acedc77",
