      "status": "artifact_captured",
      "duration_seconds": 76.608
    },
    {
      "take": "04",
      "first": "The plane vanished.",
      "last": "We went back inside.",
      "provider_context_id": "42317232f2734e6ba548fc72ba6adb16",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=42317232f2734e6ba548fc72ba6adb16",
      "durable_file": "greg-again/audio/assets/chunks/022/04.mp3",
      "status": "artifact_captured",
      "duration_seconds": 85.44
    },
    {
      "take": "05",
      "first": "The next ten minutes became work.",
      "last": "We used both sets of information.",
      "provider_context_id": "110e053b62594e5495184abe2e0a7f4f",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=110e053b62594e5495184abe2e0a7f4f",
      "durable_file": "greg-again/audio/assets/chunks/022/05.mp3",
      "status": "artifact_captured",
      "duration_seconds": 78.528
    },
    {
      "take": "06",
      "first": "That seemed fairer than deciding which one counted as expertise.",
      "last": "Cost lost narrowly.",
      "provider_context_id": "974db90976d143aa900e7bd12dba4ca3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=974db90976d143aa900e7bd12dba4ca3",
      "durable_file": "greg-again/audio/assets/chunks/022/06.mp3",
      "status": "artifact_captured",
      "duration_seconds": 80.832
    },
    {
      "take": "07",
      "first": "By sunrise the smoke had thinned enough that we could go upstairs.",
      "last": "Sometimes a fire was a fire.",
      "provider_context_id": "3b5f7e2a885b4c8f8968e82e5ca82f75",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=3b5f7e2a885b4c8f8968e82e5ca82f75",
      "durable_file": "greg-again/audio/assets/chunks/022/07.mp3",
      "status": "artifact_captured",
      "duration_seconds": 70.656
    },
    {
      "take": "08",
      "first": "Noll appeared in my doorway carrying what remained of his blanket.",
      "last": "The man sleeping on my floor tonight because his mattress had lost an argument with a bucket brigade.",
      "provider_context_id": "426a60fa3a934ef18fbcd10eec0d7a0b",
