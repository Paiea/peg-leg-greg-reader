      "sha256": "ae1195fe584fb0dffa33f631bce6680f430c9ec1da7f0991c15a71debe2f50e3"
    },
    {
      "take": 18,
      "first": "He looked back at the shirt.",
      "last": "I went upstairs.",
      "provider_context_id": "58f9ab80ff624f32b95b22f77e70b167",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/768ba332-7742-46ce-8c58-7b9b6923c1a2.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=58f9ab80ff624f32b95b22f77e70b167",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/18.mp3",
      "duration_seconds": 19.944,
      "sha256": "9645929ad7f41decec13fc39f5d01033427da096f10b334e2124475b52af7540"
    },
    {
      "take": 19,
      "first": "The next morning the city ended at the West Gate with less ceremony than I expected.",
      "last": "Same boiled leather.",
      "provider_context_id": "1e028a492ec047cd848d0a814e7187d6",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/733b7aa5-2305-4428-ae6a-50f2bcaafbea.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=1e028a492ec047cd848d0a814e7187d6",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/19.mp3",
      "duration_seconds": 22.656,
      "sha256": "efa946623fee853cb10be7cb9e544a3309117a327aaf6903e55607cf62fc5b6b"
    },
    {
      "take": 20,
      "first": "Her hair was shorter than I remembered from the tannery yard, or I had simply failed to notice it before.",
      "last": "Harl Fen was perhaps forty, narrow as a measuring rod, with a brown coat that had been patched in three different shades and a leather case full of stakes strapped to the mule.",
      "provider_context_id": "f0840049347e4f508a4afcfe8e6bf55f",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/da825417-c06a-4728-a683-4e7c43b7de6e.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=f0840049347e4f508a4afcfe8e6bf55f",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/20.mp3",
      "duration_seconds": 25.248,
      "sha256": "5728f83a6417752c15b845721bef570509d3e72ad26d25bf0ed91fd9f09030e0"
    },
    {
      "take": 21,
      "first": "He introduced the mule first.",
      "last": "Later.",
      "provider_context_id": "c5862590298b480a88aba8c807b2a354",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/7b0d952c-b43b-4ee7-ac61-f0ff4a08eafb.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=c5862590298b480a88aba8c807b2a354",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/21.mp3",
      "duration_seconds": 23.232,
      "sha256": "007c4dd6b64f78da6441ab489ae14334519f88c80ad4c22de2f14dcdf7e80b46"
    },
    {
      "take": 22,
      "first": "Edda looked at me.",
      "last": "The first two hours were almost disappointing.",
      "provider_context_id": "ad41677b85f34738944422d791d9fda3",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/9b295343-4d73-470a-b2a4-91aab6b22d90.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=ad41677b85f34738944422d791d9fda3",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/22.mp3",
      "duration_seconds": 20.376,
      "sha256": "ad2477c5c962492d537bf25050499e46bf5d1c5609580c2657fb3f0afdcbd991"
    },
    {
      "take": 23,
      "first": "Fields.",
      "last": "Nobody had mentioned that part of route certification.",
      "provider_context_id": "35556a8c48164f52b3c71f5f43ffb6e9",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/ee00f225-8342-4e89-abce-c22db0f0098a.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=35556a8c48164f52b3c71f5f43ffb6e9",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/23.mp3",
      "duration_seconds": 23.808,
      "sha256": "efe9e03878864018264b66fb65014a5fb95ad57c0d70e6c10fca63cdb27fd0ab"
    },
    {
      "take": 24,
      "first": "The West Cut began where the maintained road turned south.",
      "last": "Passable is not useful, he said.",
      "provider_context_id": "8277a592a8a245e6bd9a0a9e86b85e25",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/abccc501-1934-46b1-ab99-ded90075e5fe.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=8277a592a8a245e6bd9a0a9e86b85e25",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/24.mp3",
      "duration_seconds": 22.152,
      "sha256": "c3591a70c1aa98df6d5f25d033db93267fc12edb0c24139cda11a01829e29b07"
    },
    {
      "take": 25,
      "first": "Edda sighed.",
      "last": "A courier route needed something more annoying.",
      "provider_context_id": "24e1fb5d28ca41d9b8a4331ff5d2b8c4",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/c0da0bee-66df-4a7f-8c7a-63c3e4478949.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=24e1fb5d28ca41d9b8a4331ff5d2b8c4",
