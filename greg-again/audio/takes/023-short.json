      "duration_seconds": 24.792,
      "sha256": "228aa5e079b2e5f8582e9ee3b24220d3adada0ab26d46cf354b147103d02b98c"
    },
    {
      "take": 41,
      "first": "The road did not care.",
      "last": "No ceremony.",
      "provider_context_id": "e49974291cb3474cb21972c5713c231b",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0639c803-4fee-4f83-bc37-d58fbb5037f7.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=e49974291cb3474cb21972c5713c231b",
