      "sha256": "d33c4858ef48c3816bb04eb31bcafb2dd1590dd60590003662edda9e9a3d0b9b"
    },
    {
      "take": 42,
      "first": "Bedrolls.",
      "last": "Two hours. Wake me if you hear people, animals, falling rock, running water where there wasn't running water, or Harl explaining certification in his sleep.",
      "provider_context_id": "029ea0710164446ea5f155d73daae068",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d46f554a-f1cb-4bdf-954e-200d65fd4943.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=029ea0710164446ea5f155d73daae068",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/42.mp3",
      "duration_seconds": 22.152,
      "sha256": "4eb7ee986768a78dfefd1f927e9619b739db6fe990c5308b8f2d3465505b3140"
    },
    {
      "take": 43,
      "first": "Harl looked offended.",
      "last": "Pate slept standing because apparently mules had solved bedding.",
      "provider_context_id": "d1de2cad21604908b201c8b61dd33b9e",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0352184d-3906-42a7-8b32-2a7976598340.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=d1de2cad21604908b201c8b61dd33b9e",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/43.mp3",
      "duration_seconds": 21.216,
      "sha256": "1f59280cbcc2d3a90546d5adb3a4ea6e5ec0df88a8ef1af31a17f452ad329833"
    },
    {
      "take": 44,
      "first": "I sat with my cloak around my shoulders and the good sword across my knees.",
      "last": "I had done this hundreds of times.",
      "provider_context_id": "59d077a27bbe4a409c539e827760cf9a",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/ee3344e5-0d89-4372-b211-09d83c0786ae.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=59d077a27bbe4a409c539e827760cf9a",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/44.mp3",
      "duration_seconds": 19.272,
      "sha256": "60bf7ad4e7775fe5b33d8f52dde5486dffcb71e37067812e980131e3f15aa137"
    },
    {
      "take": 45,
      "first": "Different body.",
      "last": "I had spent so long thinking about the parts of Old Greg that did not fit anymore that I had forgotten some identities were not stored in mana capacity, rank, or memory.",
      "provider_context_id": "3421281067e945f0844c3ca2468b442f",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/2890b47d-3c6d-4ce8-842e-6b2c99dc9a0d.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=3421281067e945f0844c3ca2468b442f",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/45.mp3",
      "duration_seconds": 21.384,
      "sha256": "f3ab9790f55f528b359352faba19e74d9ced7668bb7736485040e70e97a73b94"
    },
    {
      "take": 46,
      "first": "Some were just things you did again.",
      "last": "Then I watched the road.",
      "provider_context_id": "c86e4db5f7ce487d8d537d9a113f39e0",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/139311cd-fd32-4c82-8230-ac393ec1c139.mp3",
