    },
    {
      "take": 28,
      "first": "The stream beneath it was wider than I remembered.",
      "last": "See it from attached ground.",
      "provider_context_id": "6534555a3e694a6f87bdc2b59ba7e1e0",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/7cf63b93-4d47-4a19-a70c-caff1d3f7f62.mp3",
