      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/39.mp3",
      "duration_seconds": 18.84,
      "sha256": "70d926d7b226a1d21f46ae14b67ec27660fd883142bb3b3888a80585db2af1dc"
    },
    {
      "take": 40,
      "first": "The money mattered.",
      "last": "Waiting for the future to arrive close enough that I could compare it to memory.",
      "provider_context_id": "420da1349eda4601b7496f4f617314d0",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/58f2a049-bdfb-4085-8e8e-62c462245523.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=420da1349eda4601b7496f4f617314d0",
