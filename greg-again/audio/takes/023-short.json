      "durable_file": "greg-again/audio/assets/chunks/023-short/16.mp3",
      "duration_seconds": 19.44,
      "sha256": "0ed53b8bcf524a01b7bdc084990dfe91423bb2ed724740a204fe71fd44e47e9d"
    },
    {
      "take": 17,
      "first": "Old quarry road?",
      "last": "Pieces.",
      "provider_context_id": "372e6f1e23e745f08634878930383005",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/4da05bdf-e9df-4801-baa6-299a19bd26c0.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=372e6f1e23e745f08634878930383005",
      "status": "artifact_captured",
