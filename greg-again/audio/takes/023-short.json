    },
    {
      "take": 27,
      "first": "Not dramatic clouds.",
      "last": "Half the parapet had fallen into the water and one line of surface stones had sunk toward the gap.",
      "provider_context_id": "d1a158b30083436bad4ec1439d72233e",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a04397d2-dda3-458e-9a52-ee20febaab94.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=d1a158b30083436bad4ec1439d72233e",
