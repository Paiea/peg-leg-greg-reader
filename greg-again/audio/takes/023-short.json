      "duration_seconds": 22.968,
      "sha256": "8cdcc5750ed51d9b2e2ab8578a69789a2956cc2d486964924134005c062ddca7"
    },
    {
      "take": 29,
      "first": "He looked annoyed.",
      "last": "Old ford on the route sheet. Quarter mile. If it's usable, the crossing fails but the route might not.",
      "provider_context_id": "d740d4c026c0476892701fbf249344ee",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/3846d0d0-bfb4-42f5-8c44-fa95fd3967c7.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=d740d4c026c0476892701fbf249344ee",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/29.mp3",
      "duration_seconds": 21.792,
      "sha256": "6649f0eb6fa819fafbeb46a174395c0fff6eed66563c6bb6447f984fe27db6e5"
    },
    {
      "take": 30,
      "first": "I remembered a spring north of the road.",
      "last": "Enough to be wrong.",
      "provider_context_id": "cc83505fd1004f509568a563f3b1aef1",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/ee69e6b4-4122-4541-ab48-ee76d01ed6fa.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=cc83505fd1004f509568a563f3b1aef1",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/30.mp3",
      "duration_seconds": 18.144,
      "sha256": "1202ce486e3123b6fe9f55aeb5d30f47344a057ca40d95aa217d38e10c568ec0"
    },
    {
      "take": 31,
      "first": "That answer satisfied him more than a number would have.",
      "last": "Broad stones under shallow moving water. Low approach on both banks. No obvious drop immediately downstream.",
      "provider_context_id": "efbbcdb2d8424dceb336004ff09a4c1a",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/de57c0a3-111d-4159-8317-44f4db01b95c.mp3",
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=efbbcdb2d8424dceb336004ff09a4c1a",
      "status": "artifact_captured",
      "durable_file": "greg-again/audio/assets/chunks/023-short/31.mp3",
      "duration_seconds": 23.856,
      "sha256": "30bc75c272e2057907eb7c548390be3fa952b88eb944970596f302c7ccc7ba89"
    },
    {
      "take": 32,
      "first": "Harl did not trust my memory.",
      "last": "Good choice.",
      "provider_context_id": "941249d981b24ed6afc7e89abae1fdef",
      "preview_url": null,
      "provider_audio_url": "https://www.aidocmaker.com/g0/audio?name=941249d981b24ed6afc7e89abae1fdef",
