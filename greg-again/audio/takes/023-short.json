    },
    {
      "take": 26,
      "first": "Reliable footing.",
      "last": "Clouds arrived from the west after lunch.",
      "provider_context_id": "74e3348aa8d84fb49784ca278fc4e977",
      "preview_url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/f39c7546-1e01-45e0-afa1-d4110f80b4b7.mp3",
